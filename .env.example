# Copy this file to ".env" (same folder) and paste your real key between the quotes.
# Get a free Gemini API key at: https://aistudio.google.com/apikey
# NEVER share your .env file or commit it to Git (it is listed in .gitignore).

# Required: your Google Gemini API key
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional: choose which Gemini model to use (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
